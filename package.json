{
  "name": "pickforge-monorepo",
  "version": "0.4.0-beta.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "postcss": "^8.5.18",
    "qs": "6.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live:android": "PICKFORGE_LIVE_ANDROID=1 vitest run packages/android/test/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "oxlint": "1.82.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "3.2.6"
  }
}

{
  "name": "pickforge-monorepo",
  "version": "0.4.0-beta.1",
  "private": true,
  "description": "Flutter integration CLI for Linux x86_64 and macOS arm64, with a Linux-only desktop and Android emulator lab",
  "homepage": "https://github.com/pickforge/pickforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickforge/pickforge.git"
  },
  "keywords": [
    "flutter",
    "mcp",
    "linux",
    "xvfb",
    "android",
    "emulator",
    "automation",
    "claude-code",
    "codex",
    "pi"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23.0.0"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.6",
    "postcss": "^8.5.18",
    "qs": "6.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live:android": "PICKFORGE_LIVE_ANDROID=1 vitest run packages/android/test/integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "10.7.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.6"
  }
}

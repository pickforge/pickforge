  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@pickforge/lab-android": "*",
    "@pickforge/lab-browser": "*",
    "@pickforge/lab-core": "*",
    "@pickforge/lab-desktop-linux": "*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}

{
  "name": "@pickforge/lab-mcp-server",
  "version": "0.4.0-alpha.2",
  "private": true,
  "description": "MCP server implementation for Pickforge",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
